<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique label of the job; identifies the service in the gui domain. -->
    <key>Label</key>
    <string>org.eof.tools.MCPStudio.LaunchAgent</string>

    <!-- Absolute path to the agent binary; substituted by scripts/install.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>__AGENT_PATH__</string>
    </array>

    <!-- Mach service vended by the agent via NSXPCListener(machServiceName:).
         launchd registers this name in the per-user (gui) Mach bootstrap. -->
    <key>MachServices</key>
    <dict>
        <key>group.org.eof.apps.mcpstudio.agent</key>
        <true/>
    </dict>

	<!-- Show the product name inside macOS settings pane -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
    	<string>org.eof.tools.MCPStudio</string>
	</array>

    <!-- MachServices starts the agent on demand. -->

    <!-- User-session agent: adaptive QoS tier. -->
    <key>ProcessType</key>
    <string>Adaptive</string>
</dict>
</plist>
